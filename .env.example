# Kopier til .env og fyll inn. .env skal ALDRI deles eller sjekkes inn i git.
MODUS=demo                       # demo | prod
BASE_URL=http://127.0.0.1:5000
HEMMELIG_NOKKEL=lang-tilfeldig-streng
ADMIN_BRUKERNAVN=admin           # brukes kun til å opprette den aller første admin-brukeren
ADMIN_PASSORD=demo               # sett et sterkt passord i prod – bytt det etter første innlogging

AVSENDER_EPOST=kurs@ipr.no
AVSENDER_NAVN=IPR Påmeldingssystem
ADMIN_EPOST=admin@ipr.no

# Microsoft 365 (e-post + SharePoint)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Visma (produkt bekreftes)
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_REFRESH_TOKEN=

# Mottak fra nettsidens skjema
WEBHOOK_HEMMELIG=lang-tilfeldig-streng

# KI-assistent
ANTHROPIC_API_KEY=
ASSISTENT_MODELL=claude-opus-5

SLETT_SENSITIVT_ETTER_DAGER=14
