# Kopier til .env og fyll inn. .env skal ALDRI deles eller sjekkes inn i git.
# I drift (Azure App Service) settes disse som App Settings / Key Vault-referanser - ikke som fil.
# Full oversikt (påkrevd lokalt / sandbox / prod, hemmelig eller ikke): se DEPLOYMENT.md.

MODUS=demo                       # demo | prod. prod = ekte e-post, faktura, Zoom, SharePoint
BASE_URL=http://127.0.0.1:5000   # prod: https://... (må være https)
HEMMELIG_NOKKEL=lang-tilfeldig-streng   # prod: minst 32 tilfeldige tegn (f.eks. python -c "import secrets;print(secrets.token_urlsafe(48))")

# Database: tom = SQLite i data/kurs.db (lokalt). Satt = PostgreSQL (Azure).
DATABASE_URL=
# DATABASE_URL=postgresql://bruker:passord@server.postgres.database.azure.com:5432/ipr?sslmode=require

# Første admin-bruker (brukes KUN når databasen ikke har noen brukere ennå). prod: minst 12 tegn, ikke «demo».
ADMIN_BRUKERNAVN=admin
ADMIN_PASSORD=demo
# Lokal innlogging med brukernavn/passord: 1 i demo. I drift: 0 (kun Microsoft), eller 1 for nødbrukere.
ADMIN_LOKAL_INNLOGGING=1

AVSENDER_EPOST=kurs@ipr.no
AVSENDER_NAVN=IPR Påmeldingssystem
ADMIN_EPOST=admin@ipr.no

# Microsoft 365 (e-post via Graph + SharePoint) - app-registrering med applikasjonstillatelser (se AZURE-SETUP.md)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# Admin-innlogging med Microsoft Entra ID (tomt = faller tilbake til M365_*; alt tomt = Entra av)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# App-roller i app-registreringen -> rolle i systemet (standard under). Alternativt grupper: ENTRA_GRUPPER=<oid>=system,<oid>=kursadmin
ENTRA_ROLLER=ipr.system=system,ipr.kursadmin=kursadmin,ipr.lese=lese
ENTRA_GRUPPER=

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Visma (produkt må bekreftes - se kurs/integrasjoner/visma.py)
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_REFRESH_TOKEN=

# Mottak fra nettsidens skjema (/api/paamelding). prod: minst 32 tilfeldige tegn.
WEBHOOK_HEMMELIG=lang-tilfeldig-streng

# KI-assistent («Spør oss»). Uten nøkkel / i demo brukes ordmatching mot kunnskapsbasen.
ANTHROPIC_API_KEY=
ASSISTENT_MODELL=claude-opus-5
ASSISTENT_AKTIV=1                # 0 = siden er av
ASSISTENT_MAKS_PER_DAG=300       # kostnadsgrense: KI-kall per døgn
ASSISTENT_TIDSAVBRUDD_SEK=20

SLETT_SENSITIVT_ETTER_DAGER=14
