# Kopier til .env og fyll inn. .env skal ALDRI deles eller sjekkes inn i git.
# I drift (Azure App Service) settes disse som App Settings / Key Vault-referanser - ikke som fil.
# Full oversikt (påkrevd lokalt / sandbox / prod, hemmelig eller ikke): se DEPLOYMENT.md.

MODUS=demo                       # demo | prod. prod = ekte e-post, faktura, Zoom, SharePoint
BASE_URL=http://127.0.0.1:5000   # prod: https://... (må være https)
HEMMELIG_NOKKEL=lang-tilfeldig-streng   # prod: minst 32 tilfeldige tegn (f.eks. python -c "import secrets;print(secrets.token_urlsafe(48))")

# Database: tom = SQLite i data/kurs.db (lokalt). Satt = PostgreSQL (Azure).
DATABASE_URL=
# DATABASE_URL=postgresql://bruker:passord@server.postgres.database.azure.com:5432/ipr?sslmode=require

# Første admin-bruker (brukes KUN når databasen ikke har noen brukere ennå). prod: minst 12 tegn, ikke «demo».
ADMIN_BRUKERNAVN=admin
ADMIN_PASSORD=demo
# Lokal innlogging med brukernavn/passord: 1 i demo. I drift: 0 (kun Microsoft), eller 1 for nødbrukere.
ADMIN_LOKAL_INNLOGGING=1

AVSENDER_EPOST=kurs@ipr.no
AVSENDER_NAVN=IPR Påmeldingssystem
ADMIN_EPOST=admin@ipr.no

# Microsoft 365 (e-post via Graph + SharePoint) - app-registrering med applikasjonstillatelser (se AZURE-SETUP.md)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# Admin-innlogging med Microsoft Entra ID (tomt = faller tilbake til M365_*; alt tomt = Entra av)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# App-roller i app-registreringen -> rolle i systemet (standard under). Alternativt grupper: ENTRA_GRUPPER=<oid>=system,<oid>=kursadmin
ENTRA_ROLLER=ipr.system=system,ipr.kursadmin=kursadmin,ipr.lese=lese
ENTRA_GRUPPER=

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Visma (produkt må bekreftes - se kurs/integrasjoner/visma.py)
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_REFRESH_TOKEN=

# Mottak fra nettsidens skjema (/api/paamelding). prod: minst 32 tilfeldige tegn.
WEBHOOK_HEMMELIG=lang-tilfeldig-streng

# Deltakerens private adresse (adresse, postnr, poststed) MÅ være med ved påmelding, uansett vei inn: det offentlige skjemaet,
# bedriftspåmeldingen, «Legg til deltaker», webhooken fra ipr.no og CSV-importen (fakturaen sendes automatisk ved påmelding, tidligst
# seks måneder før første kursdag, og da må adressen være klar). Uten adresse svarer webhooken 400, og CSV-importen blokkerer raden.
# Begge innstillingene er PÅ som standard (1). Bare 0 slår dem av: en NØDBREMS som bare skal brukes midlertidig hvis noe stopper.
# Webhook med nødbremsen på: påmeldingen går ikke tapt. Den tas inn selv om adressen mangler (en delvis adresse tas vare på), merkes
# «Privat adresse mangler» eller «Privat adresse er ufullstendig», og fakturaen holdes tilbake til alle tre feltene er lagt inn (en privat
# faktura lages aldri uten komplett adresse). Når ipr.no sender adressen
# riktig, settes innstillingen tilbake til 1. Før produksjon MÅ skjemaet/pluginen på ipr.no sende adresse, postnr og poststed (se OPERATIONS.md).
ADRESSE_KREVES_I_WEBHOOK=1
ADRESSE_KREVES_I_CSV=1

# KI-assistent («Spør oss»). Uten nøkkel / i demo brukes ordmatching mot kunnskapsbasen.
ANTHROPIC_API_KEY=
ASSISTENT_MODELL=claude-opus-5
ASSISTENT_AKTIV=0                # 0 = «Spør oss» og Kunnskapsbase er av (standard). 1 = slå dem på
ASSISTENT_MAKS_PER_DAG=300       # kostnadsgrense: KI-kall per døgn
ASSISTENT_TIDSAVBRUDD_SEK=20

SLETT_SENSITIVT_ETTER_DAGER=14

# Innsjekk: 1 = uinnloggede må logge inn (engangslenke på e-post) før de kan registrere oppmøte med QR-koden. Standard: 0 (e-postadresse holder).
INNSJEKK_KREVER_INNLOGGING=0

# Kursside (siden deltakerne ser etter innlogging). Standardverdiene er de som er anbefalt; utelat linjene for å bruke dem.
KURSSIDE_ETTERTILGANG_DAGER=180          # standard: siden er åpen til siste kursdag + så mange dager (hvert kurs kan endre det: 1-3650 dager, dato eller ingen grense)
KURSSIDE_TOM_TABELLER_ETTER_DAGER=30     # gruppelister (tabeller med navn) tømmes så mange dager etter siste kursdag
KURSSIDE_FIL_MAKS_MB=15                  # største dokument (presentasjon, PDF ...)
KURSSIDE_BILDE_MAKS_MB=5                 # største bilde
KURSSIDE_KURS_MAKS_MB=100                # alle filer på ett kurs til sammen
KURSSIDE_MAKS_FILER=200                  # antall filer på ett kurs

# Bare lokal prøving: 1 = slå opp ekte organisasjonsnumre og firmanavn i Enhetsregisteret også i demo (åpne data, ingen nøkler;
# bare nummeret/søketeksten sendes). Oppdiktede demovirksomheter (999 900 xxx) svarer fortsatt uten nettverk. Standard: 0.
BRREG_LIVE=0
